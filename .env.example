APP_NAME="HolidayGoGoGo CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time inbox: "reverb" (recommended) or "log" (inbox refreshes every few seconds instead)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Background jobs: "redis" (with Horizon, recommended for production) or "database"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Laravel Reverb (real-time) -------------------------------------------
# Run "php artisan reverb:install" once: it adds the REVERB_* keys below this
# file and switches BROADCAST_CONNECTION to reverb. See docs/DEPLOYMENT.md for
# the production values (REVERB_HOST=your domain, REVERB_PORT=443, https).

# --- Meta: WhatsApp Cloud API + Facebook Messenger ---------------------------
# From developers.facebook.com -> your app -> App settings -> Basic
META_APP_ID=
META_APP_SECRET=
# Any random string. Paste the same value into Meta's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# true = demo mode: nothing is sent to Meta, and admins can simulate incoming messages
META_FAKE=false
# true only after Meta approves the "Human Agent" feature for your app
META_MESSENGER_HUMAN_AGENT=false

# --- CRM ---------------------------------------------------------------------
# Used to convert local numbers, e.g. 012-3456789 -> 60123456789
CRM_DEFAULT_COUNTRY_CODE=60
# Maximum blast messages per minute
CRM_BROADCAST_PER_MINUTE=300
